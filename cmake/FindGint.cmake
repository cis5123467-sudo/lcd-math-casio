# The local SDK keeps gint in fxSDK's sysroot rather than GCC's library search path.
# Resolve it with fxSDK, retaining the standard Gint::Gint target and colour linker script.
execute_process(COMMAND fxsdk path include OUTPUT_VARIABLE FXSDK_INCLUDE OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND fxsdk path lib OUTPUT_VARIABLE FXSDK_LIB OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
file(STRINGS "${FXSDK_INCLUDE}/gint/config.h" GINT_VERSION_LINE REGEX "^#define GINT_VERSION ")
string(REGEX REPLACE ".*\"([^\"]+)\".*" "\\1" GINT_VERSION "${GINT_VERSION_LINE}")
find_library(GINT_LIBRARY NAMES gint-cg PATHS "${FXSDK_LIB}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_library(FXLIBC_LIBRARY NAMES c PATHS "${FXSDK_LIB}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(Gint REQUIRED_VARS GINT_LIBRARY FXLIBC_LIBRARY VERSION_VAR GINT_VERSION)
if(Gint_FOUND AND NOT TARGET Gint::Gint)
  add_library(Gint::Gint UNKNOWN IMPORTED)
  set_target_properties(Gint::Gint PROPERTIES IMPORTED_LOCATION "${GINT_LIBRARY}"
    INTERFACE_SYSTEM_INCLUDE_DIRECTORIES "${FXSDK_INCLUDE}"
    INTERFACE_INCLUDE_DIRECTORIES "${FXSDK_INCLUDE}"
    INTERFACE_COMPILE_DEFINITIONS FXCG50
    INTERFACE_COMPILE_OPTIONS -fstrict-volatile-bitfields
    INTERFACE_LINK_DIRECTORIES "${FXSDK_LIB}"
    INTERFACE_LINK_OPTIONS "-T;${FXSDK_LIB}/fxcg50.ld"
    INTERFACE_LINK_DEPENDS "${FXSDK_LIB}/fxcg50.ld"
    INTERFACE_LINK_LIBRARIES "${FXLIBC_LIBRARY};-lopenlibm;-lgcc")
endif()
